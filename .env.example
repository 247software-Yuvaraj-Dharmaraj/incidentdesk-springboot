# --- Database (PostgreSQL — Neon / Supabase / local) ---
# Spring expects a JDBC URL. For Neon, take your connection string and use the jdbc form:
#   jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/incidentdesk
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret
# COOKIE_SECURE=true in production (HTTPS) so the auth cookie uses SameSite=None; Secure
COOKIE_SECURE=false

# --- Frontend origin (CORS) ---
CLIENT_URL=http://localhost:5173

# --- Server ---
PORT=4000

# --- Realtime (Socket.IO) ---
SOCKET_ENABLED=true
SOCKET_PORT=9092

# --- AI triage (optional). Free key: https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
